<!DOCTYPE html>
<html lang="hu">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Munkaidő Napló</title>
    <style>
        :root {
            --bg: #0f0f0f; --card: #1a1a1a; --text: #ffffff;
            --accent: #007aff; --border: #2c2c2e; --secondary: #8e8e93;
        }
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: var(--bg); margin: 0; padding: 20px; color: var(--text); }
        .container { max-width: 450px; margin: auto; background: var(--card); padding: 30px; border-radius: 24px; box-shadow: 0 20px 40px rgba(0,0,0,0.6); text-align: center; border: 1px solid var(--border); }
        h1 { font-size: 24px; margin-bottom: 30px; }
        .main-btn { display: flex; align-items: center; justify-content: center; background: #262626; color: white; padding: 20px; margin: 15px auto; border: 1px solid var(--border); border-radius: 16px; font-size: 16px; font-weight: 500; transition: all 0.2s ease; width: 100%; cursor: pointer; }
        .main-btn:active { transform: scale(0.98); background: #333; }
        .main-btn i { font-size: 20px; margin-right: 12px; font-style: normal; }
        .hidden { display: none; }
        .back-btn { background: transparent; color: var(--secondary); margin-top: 25px; border: 1px solid #333; width: 100%; padding: 12px; border-radius: 12px; cursor: pointer; }
        .time-display { font-size: 32px; font-weight: bold; color: var(--accent); margin: 20px 0; }
        .info-text { color: var(--secondary); font-size: 14px; margin-bottom: 10px; }
    </style>
</head>
<body>

<div class="container" id="main-menu">
    <h1>Munkaidő Kezelő</h1>
    <button class="main-btn" onclick="showWorkTime(15)"><i>⏱️</i> MUNKAIDŐ (15p kerekítés)</button>
    <button class="main-btn" onclick="showWorkTime(30)"><i>⏳</i> MUNKAIDŐ (30p kerekítés)</button>
    <button class="main-btn" onclick="showWorkTime(0)"><i>📅</i> MUNKAIDŐ (jelenlét)</button>
</div>

<div class="container hidden" id="time-screen">
    <h2 id="screen-title">Munkaidő</h2>
    <div class="info-text">Aktuális idő:</div>
    <div class="time-display" id="current-time">00:00:00</div>
    <div class="info-text">Kerekített érték:</div>
    <div class="time-display" style="color: #30d158;" id="rounded-time">-</div>
    <button class="back-btn" onclick="showMenu()">Vissza</button>
</div>

<script>
    let timerInterval;

    function showMenu() {
        document.getElementById('time-screen').classList.add('hidden');
        document.getElementById('main-menu').classList.remove('hidden');
        clearInterval(timerInterval);
    }

    function showWorkTime(rounding) {
        document.getElementById('main-menu').classList.add('hidden');
        document.getElementById('time-screen').classList.remove('hidden');
        
        const title = document.getElementById('screen-title');
        if (rounding === 0) title.innerText = "Jelenlét (Pontos)";
        else title.innerText = `Munkaidő (${rounding}p kerekítés)`;

        updateTime(rounding);
        timerInterval = setInterval(() => updateTime(rounding), 1000);
    }

    function updateTime(rounding) {
        const now = new Date();
        const h = String(now.getHours()).padStart(2, '0');
        const m = String(now.getMinutes()).padStart(2, '0');
        const s = String(now.getSeconds()).padStart(2, '0');
        
        document.getElementById('current-time').innerText = `${h}:${m}:${s}`;

        if (rounding === 0) {
            document.getElementById('rounded-time').innerText = `${h}:${m}`;
        } else {
            document.getElementById('rounded-time').innerText = getRoundedTime(now, rounding);
        }
    }

    function getRoundedTime(date, minutes) {
        let ms = 1000 * 60 * minutes;
        let rounded = new Date(Math.round(date.getTime() / ms) * ms);
        let rh = String(rounded.getHours()).padStart(2, '0');
        let rm = String(rounded.getMinutes()).padStart(2, '0');
        return `${rh}:${rm}`;
    }
</script>

</body>
</html>
